[Unit]
Description=PetPulse Spring Boot backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=petpulse
Group=petpulse
WorkingDirectory=/opt/petpulse/backend
EnvironmentFile=/etc/petpulse/backend.env
ExecStart=/usr/bin/java -jar /opt/petpulse/backend/app.jar --server.address=127.0.0.1 --server.port=8080
Restart=on-failure
RestartSec=5
SuccessExitStatus=143
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
