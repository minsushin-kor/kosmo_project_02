[Unit]
Description=PetPulse FastAPI AI server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=petpulse
Group=petpulse
WorkingDirectory=/opt/petpulse/fastapi
EnvironmentFile=/etc/petpulse/fastapi.env
ExecStart=/opt/petpulse/fastapi/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
