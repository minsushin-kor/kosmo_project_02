# Spring Boot API 기본 경로 (개발 서버에서는 Vite 프록시 사용)
VITE_API_BASE_URL=/api
VITE_SPRING_API_TARGET=http://localhost:8080

# QR 공개 프로필 주소 (운영 환경에서는 실제 HTTPS 도메인으로 교체)
VITE_PUBLIC_BASE_URL=http://localhost:5173
VITE_LOCAL_BASE_URL=http://localhost:5173
# 휴대폰 LAN 테스트가 필요하면 0.0.0.0으로 설정
VITE_DEV_HOST=localhost
